<?xml version="1.0" encoding="utf-8"?>
<!--
  GW-44 - adaptive launcher icon (API 26+).

  This file is only half the icon. minSdkVersion is 23, and API 23-25 never look in
  mipmap-anydpi-v26: they load the rasterised mipmap-{m,h,xh,xxh,xxxh}dpi/ic_launcher.png
  buckets instead. Deleting those PNGs leaves Android 6 and 7 with no launcher icon at all,
  and neither test device can show it - both are API 26+, so both only ever load this file.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
