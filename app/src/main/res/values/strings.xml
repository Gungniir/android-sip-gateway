<?xml version="1.0" encoding="utf-8"?>
<!--
  GW-40 - every user-facing string in the app, in one place.

  Before this commit there were 4 entries here and 68 literals hardcoded elsewhere:
  43 android:text and 11 android:hint in activity_main.xml (which contained ZERO @string
  references for text or hint), 4 in MainActivity and 10 setValue sites in MainViewModel.

  Naming convention - prefix by ROLE, not by screen, because GW-41 is about to move most of
  these to different screens in wave 2:

    section_   a section header
    label_     the label of a control or a status field
    option_    one choice inside a radio group / checkbox / spinner
    hint_      an EditText hint
    help_      explanatory text under a control
    action_    a button
    status_    a status value the UI shows, including its initial placeholder
    toast_     a transient message
    select_    a Spinner dialog prompt (android:prompt)

  Localisation is explicitly out of scope for Phase 4 (PHASE-4-PLAN section 8). Extracting
  the strings is what makes it possible later; we ship English.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <string name="app_name">GSM-SIP Gateway</string>

    <!-- ==================================================================================
         Status
         ================================================================================== -->
    <string name="label_status">Status:</string>
    <string name="status_not_started">Not started</string>
    <string name="status_not_connected">Not connected</string>
    <string name="status_service_stopped">Service: Stopped</string>

    <string name="label_permissions">Permissions (via root):</string>
    <string name="status_checking">Checking…</string>
    <string name="status_no_mixer_controls">No mixer controls found. Check root permissions.</string>

    <!-- ==================================================================================
         SIP configuration
         ================================================================================== -->
    <string name="section_sip_config">SIP Configuration:</string>
    <string name="hint_sip_server">SIP Server</string>
    <string name="hint_sip_port">SIP Port</string>
    <string name="hint_sip_user">SIP Username</string>
    <string name="hint_sip_password">SIP Password</string>
    <string name="hint_sip_realm">SIP Realm (empty = any)</string>
    <string name="option_use_tls">Use TLS (port 5061)</string>

