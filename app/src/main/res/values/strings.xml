         references them from android:prompt on the capture, playback and mixer spinners.
         PHASE-4-PLAN section C2 records them as dead because it only counted
         android:text and android:hint references; they are not. -->
    <string name="select_capture">Select Capture Device (GSM→SIP)</string>
    <string name="select_playback">Select Playback Device (SIP→GSM)</string>
    <string name="select_mixer">Select Mixer Route</string>

