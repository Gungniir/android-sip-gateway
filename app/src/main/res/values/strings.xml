    <string name="hint_rx_gain_default">0</string>

    <string name="action_save_audio">Save Audio</string>
    <string name="action_restart">Restart</string>

    <!-- ==================================================================================
         Device mute preset
         ================================================================================== -->
    <string name="section_device_mute">Device Mute Preset:</string>
    <string name="help_device_mute">Mutes speaker/mic on gateway during calls (enforced every 3s)</string>
    <string name="label_detected_controls">Detected mixer controls (tap to toggle):</string>
    <string name="label_manual_controls">Manual controls (comma-separated, for controls not in list):</string>
    <!-- DEC1 / ADC1 are Qualcomm ALSA mixer control names; the spell checker reads the
         trailing digit as "!". Same reason as the SIM1/SIM2 opt-out above. -->
    <string name="hint_manual_controls" tools:ignore="Typos">e.g. DEC1 Volume, EAR_S, ADC1 MUX</string>
    <string name="help_manual_controls">Use \'Volume\' suffix for INT controls (→0), others are ENUM (→ZERO)</string>

    <!-- ==================================================================================
         Web interface
         ================================================================================== -->
    <string name="label_web_interface">Web Interface (port 8080)</string>
    <string name="label_web_interface_enabled">Web Interface: http://%1$s:8080</string>
    <string name="label_web_interface_disabled">Web Interface (disabled)</string>

    <!-- ==================================================================================
         Transient messages
         ================================================================================== -->
    <string name="toast_connecting">Connecting to SIP server…</string>
    <string name="toast_disconnected">Disconnected</string>
    <string name="toast_restarting">Restarting…</string>
    <string name="toast_restarted">Restarted</string>
    <string name="toast_service_not_connected">Service not connected</string>
    <string name="toast_test_call">Test call to %1$s (%2$s)</string>
    <string name="toast_verbose_sip_log_on">Verbose PJSIP logging on (restart service to apply)</string>
    <string name="toast_verbose_sip_log_off">Verbose PJSIP logging off (restart service to apply)</string>
    <string name="toast_dtmf_relay_on">DTMF relay on</string>
    <string name="toast_dtmf_relay_off">DTMF relay off</string>
    <string name="toast_sip_settings_saved">SIP settings saved</string>
