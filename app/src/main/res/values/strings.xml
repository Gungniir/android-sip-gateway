    <string name="hint_sim2_destination" tools:ignore="Typos">SIM2 → ext</string>
    <string name="help_sim2_optional" tools:ignore="Typos">Leave SIM2 empty if single-SIM phone</string>

    <string name="label_incoming_mode">Incoming call mode:</string>
    <string name="option_mode_sip_first">Start SIP → Answer GSM when connected (30s timeout)</string>
    <string name="option_mode_answer_first">Answer GSM → Start SIP (30s timeout)</string>

    <string name="action_save_settings">Save Settings</string>
    <string name="action_connect">Connect</string>
    <string name="action_disconnect">Disconnect</string>

    <!-- ==================================================================================
         SIP diagnostics
         ================================================================================== -->
    <string name="section_sip_diagnostics">SIP Diagnostics:</string>
    <string name="help_test_call">Places a SIP call with no GSM leg. *43 is the FreePBX echo test.</string>
    <string name="hint_test_destination">Destination</string>
    <string name="action_test_call">Test Call</string>
    <string name="action_hang_up">Hang Up</string>
    <string name="option_verbose_sip_log">Verbose PJSIP logging (level 5, needs restart)</string>
    <string name="option_dtmf_relay">Relay DTMF from SIP to GSM (far-end voice menus)</string>
