<?xml version="1.0" encoding="utf-8"?>
<!--
  GW-41 - the status-first main screen.

  What was here: 565 lines, 14 unlabelled groups of stock widgets stacked in declaration
  order inside twelve nested LinearLayouts and one ScrollView. Title, status, permissions,
  SIP config, SIM routing, call mode, save/connect/disconnect, SIP diagnostics, battery
  limit, audio config, gain, mute preset, save-audio/restart, web interface - in that order,
  with nothing to say where one ended and the next began.

  What it is now: a status header above four collapsible sections, all of it inside one
  ScrollView. That shape comes from what the device is (PHASE-4-UI-PLAN section 2) - a rooted
  phone in a drawer with three jobs: commissioning, at-a-glance health, and diagnostics when
  something has broken and you are holding the phone. Health is the header, which is why it
  comes first; commissioning is the SIP section, which is why it is the one that starts open;
  diagnostics is one tap away rather than a scroll away.

  The header was originally pinned outside the ScrollView. It scrolls with everything else
  now, by the owner's decision: on a short screen the pinned panel ate enough height that the
  section it sat above had very little left, and the header is tall - six labelled rows plus
  the watchdog block. Scrolling to the top to read it is the cheaper cost.

  Density is deliberate. This is a bench instrument, not a consumer app, and whitespace-heavy
  styling would put fewer facts in front of someone standing over a phone with a fault.

  Section expansion is view state and lives in MainViewModel, not here and not in
  MainActivity - see MainViewModel.Section.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/gw_screen_margin"
    android:paddingEnd="@dimen/gw_screen_margin"
    android:paddingTop="@dimen/gw_space_sm">

    <ScrollView
        android:id="@+id/sectionScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <!-- focusable/focusableInTouchMode so the first EditText does not take focus and
             raise the keyboard the moment the screen opens; carried over from the old
             layout, where it was the only piece of deliberate behaviour in the file. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingTop="@dimen/gw_panel_gap"
            android:paddingBottom="@dimen/gw_space_xxl">

            <include layout="@layout/view_status_header"/>

            <include layout="@layout/section_sip"/>

            <include layout="@layout/section_audio"/>

            <include layout="@layout/section_diagnostics"/>

            <include layout="@layout/section_system"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
