<?xml version="1.0" encoding="utf-8"?>
<!--
  GW-44 - status-bar icon for the PjsipSipService foreground notification.

  WHITE ON TRANSPARENT, AND NOTHING ELSE. From API 21 the system takes a notification small
  icon's ALPHA CHANNEL and throws the colour away, re-tinting it per theme. A filled or
  coloured drawable therefore does not render as artwork - it renders as a solid white blob
  in the status bar. That is why every fill here is @android:color/white on an otherwise
  empty canvas, and why the shape has to carry the meaning through its silhouette alone.
  minSdkVersion is 23, so there is no pre-masking Android version to fall back on.

  The mark is the launcher's mast (drawable/ic_launcher_foreground.xml) redrawn for 24dp
  rather than scaled: at this size the launcher's proportions collapse, so the arcs are
  fewer degrees, the column is proportionally fatter and the base plate is wider. Content
  stays inside the 20dp box Material leaves at (2,2)-(22,22).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Mast tip. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,6.8a2.2,2.2 0 1 1 0,4.4a2.2,2.2 0 1 1 0,-4.4z" />

    <!-- Mast column. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10.7,10.5h2.6v7h-2.6z" />

    <!-- Base plate. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8.5,16.8h7a1,1 0 0 1 1,1v0.6a1,1 0 0 1 -1,1h-7a1,1 0 0 1 -1,-1v-0.6a1,1 0 0 1 1,-1z" />

    <!-- Radiated arcs, centred on the mast tip (12, 9): r=5.2 inner, r=8.2 outer. -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M7.25,11.115a5.2,5.2 0 0 1 0,-4.23" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M4.509,12.335a8.2,8.2 0 0 1 0,-6.67" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M16.75,11.115a5.2,5.2 0 0 0 0,-4.23" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M19.491,12.335a8.2,8.2 0 0 0 0,-6.67" />
</vector>
