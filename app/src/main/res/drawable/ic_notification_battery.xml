<?xml version="1.0" encoding="utf-8"?>
<!--
  GW-44 - status-bar icon for the BatteryLimitService foreground notification.

  WHITE ON TRANSPARENT, AND NOTHING ELSE - see ic_notification_gateway.xml for why. The
  system keeps only the alpha channel, so a coloured drawable renders as a white blob.

  Deliberately NOT the same mark as the gateway notification: both services can be in the
  status bar at once, and the shipping build used android.R.drawable.ic_lock_idle_low_battery
  here, which says "low battery" - the opposite of what this service does. It caps charging.
  So: an outlined cell with a part-height fill, where the top of the fill is the cap. The
  body is a STROKED path rather than two filled rectangles, because the silhouette is all
  the system keeps and an outline has to survive as an outline.

  Content stays inside the 20dp box Material leaves at (2,2)-(22,22).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Terminal cap. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10.9,2.6h2.2a0.7,0.7 0 0 1 0.7,0.7v0.6a0.7,0.7 0 0 1 -0.7,0.7h-2.2a0.7,0.7 0 0 1 -0.7,-0.7v-0.6a0.7,0.7 0 0 1 0.7,-0.7z" />

    <!-- Cell body, stroked: outer extent (6.5, 4.4) - (17.5, 21.0). -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:pathData="M9.2,5.3h5.6a1.8,1.8 0 0 1 1.8,1.8v11.2a1.8,1.8 0 0 1 -1.8,1.8h-5.6a1.8,1.8 0 0 1 -1.8,-1.8v-11.2a1.8,1.8 0 0 1 1.8,-1.8z" />

    <!-- Charge held at the limit; the top edge of this fill is the cap. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10.1,12.3h3.8a0.8,0.8 0 0 1 0.8,0.8v4.3a0.8,0.8 0 0 1 -0.8,0.8h-3.8a0.8,0.8 0 0 1 -0.8,-0.8v-4.3a0.8,0.8 0 0 1 0.8,-0.8z" />
</vector>
